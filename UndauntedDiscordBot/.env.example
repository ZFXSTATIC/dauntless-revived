DISCORD_BOT_TOKEN=
# Admin account key: only sent to the local metagame, never Discord.
METAGAME_ADMIN_KEY=
METAGAME_URL=http://127.0.0.1:61000
KEY_STATE_FILE=./data/keys.json
# Installed public server configuration: host, gateway port and TLS certificate fingerprint.
SERVER_CONFIG_FILE=C:/DauntlessRevived/data/config/server.json
# Optional: allow commands only in this guild and bot DMs.
DISCORD_GUILD_ID=
# Optional: loopback deploy-server ports polled for the live game stats channels (players online, hunts running).
GAME_STATS_PORTS=61001,61041,61042,61051
# Optional: Discord category ID that holds the stats channels (defaults to the counter category).
GAME_STATS_CATEGORY_ID=
