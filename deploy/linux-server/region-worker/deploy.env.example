SERVER_ROLE=game
PORT=61001
BIND_HOST=127.0.0.1
MY_IP=@MY_IP@
HUNT_WORKER=1
WORKER_RAMSGATE=1
WORKER_DOJO=1
ENABLE_DOJO=0
PORT_RANGE_BEGIN=8700
PORT_RANGE_END=8775
GAMESERVER_BINARY_PATH=/opt/dr-worker/gameserver.sh
GAMESERVER_READY_DIR=/var/lib/dr-worker/ready
GAMESERVER_CPU_GUARD=1
GAMESERVER_CPU_LIMIT_PERCENT=80
GAMESERVER_CPU_RESUME_PERCENT=65
GAMESERVER_MEMORY_GUARD=1
GAMESERVER_MIN_FREE_MB=4096
GAMESERVER_STARTUP_MB=1536
GAMESERVER_HUNT_STARTUP_MB=1024
GAMESERVER_RESERVATION_SECONDS=60
SECONDS_TO_WAIT_BETWEEN_GAMESERVER_STARTUP=3
HUNT_MAX_AGE_MINUTES=120
HUNT_EMPTY_MINUTES=6
MAX_HUNTS=@MAX_HUNTS@
NODE_ENV=production
METAGAME_API_KEY=FILL_ON_THE_BOX_SAME_AS_THE_OTHER_WORKERS
